# --- VOYAGER v2 .env.example (commit this; put real values in .env) ---

# LLM Provider
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=your_gemini_key

# Google Maps Platform (Places New, Geocoding, Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# SerpAPI (Google Maps reviews, ride prices, directions)
SERPAPI_API_KEY=your_serpapi_key

# DataImpulse proxy (news loop, DDG fallback, review scans)
DATAIMPULSE_USER=your_dataimpulse_username
DATAIMPULSE_PASS=your_dataimpulse_password
DATAIMPULSE_HOST=gw.dataimpulse.com:823

# Postgres (free Neon/Supabase)
DATABASE_URL=postgresql://user:pass@host/voyager?sslmode=require

# Fuel & defaults
FUEL_PRICE_PER_LITER=110.0
PETROL_AVG_MILEAGE=15.0

# Test time override (optional; e.g. 15:30)
VOYAGER_TEST_TIME=
